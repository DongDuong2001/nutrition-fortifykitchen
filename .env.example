# ==========================================
# H1T MICRO — Unified Environment Variables
# ==========================================

# ------------------------------------------
# Backend API (apps/api)
# ------------------------------------------
PORT=8080
ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100,http://localhost:3101,http://localhost:3102

# Supabase Auth & JWT Verification
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# For modern Supabase ECC P-256 JWKS verification:
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Legacy HMAC secret (optional if using JWKS):
SUPABASE_JWT_SECRET=

# PayOS VietQR Gateway
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Fortify Kitchen Core API
FORTIFY_CORE_API_URL=
FORTIFY_CORE_API_KEY=

# GitHub Vault Ingestion
GITHUB_VAULT_WEBHOOK_SECRET=
GITHUB_VAULT_PAT=

# Monitoring & Error Reporting
SENTRY_DSN=

# hCaptcha Bot Protection
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# ------------------------------------------
# Frontend Web App (apps/web)
# ------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Tài liệu (Cài đặt › Tài liệu): the code that unlocks editing and uploading documents; unset means read-only.
# The documents live in a private Storage bucket named "documents", read with SUPABASE_SERVICE_ROLE_KEY above.
ACCESS_CODE=

# ------------------------------------------
# Offsite Database Backup & Cold Storage (S3 / R2)
# ------------------------------------------
BACKUP_STORAGE_BUCKET=
BACKUP_STORAGE_KEY_ID=
BACKUP_STORAGE_SECRET_KEY=
BACKUP_STORAGE_REGION=ap-southeast-1
BACKUP_STORAGE_ENDPOINT=
