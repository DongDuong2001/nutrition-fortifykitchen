# Copy to deploy/.env.prod on the VPS, fill in the values, then chmod 600.
# deploy/.env.prod is git-ignored. Never commit real values.

# --- web (build args, baked into the bundle at build time) ---
NEXT_PUBLIC_API_MODE=live
NEXT_PUBLIC_API_URL=https://api.lehongkhanh.vn/api/v1
NEXT_PUBLIC_SITE_URL=https://lehongkhanh.vn
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=

# --- api (runtime env_file) ---
PORT=8080
ENVIRONMENT=production
DATABASE_URL=
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
CORS_ALLOWED_ORIGINS=https://lehongkhanh.vn,https://www.lehongkhanh.vn
HCAPTCHA_SECRET_KEY=
