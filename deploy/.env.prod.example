# Copy to deploy/.env.prod on the VPS, fill in the values, then chmod 600.
# deploy/.env.prod is git-ignored. Never commit real values.

# --- web (build args, baked into the bundle at build time) ---
NEXT_PUBLIC_API_MODE=live
# Use /api/v1 for same-origin proxying via Caddy (avoids cross-origin cookie loss), or full URL:
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_SITE_URL=https://lehongkhanh.vn
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=

# --- api (runtime env_file) ---
PORT=8080
ENVIRONMENT=production
DATABASE_URL=
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
CORS_ALLOWED_ORIGINS=https://lehongkhanh.vn,https://www.lehongkhanh.vn
HCAPTCHA_SECRET_KEY=
# Session revocation check against auth.sessions (default false).
# Turn on only after hitmicro-staging shows real sessions are found (a valid login must still get 200).
SESSION_REVOCATION_ENABLED=false

# --- smoke test (deploy/smoke.sh) ---
# Server only, never a build arg: the Supabase service role key. smoke.sh sends it on the smoke account's
# password sign-in to skip the captcha. Leave empty to use the anon key.
SMOKE_SERVICE_KEY=
